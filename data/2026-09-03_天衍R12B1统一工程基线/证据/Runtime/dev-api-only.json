  },
  "proxiedApi": {
    "entry": "http://127.0.0.1:46043/__local/story-studio/bootstrap",
    "status": 200
  },
  "health": {
    "entry": "http://127.0.0.1:37937/__local/story-studio/health",
    "status": 200,
    "body": {
      "data": {
        "status": "healthy",
        "runtimeMode": "api-only"
      }
