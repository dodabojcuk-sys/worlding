# Optional local-only data root. Keep real paths and credentials in an ignored .env file.
WORLD_OS_STORY_STUDIO_ROOT=/absolute/path/to/local/story-studio-data
WORLD_OS_STORY_STUDIO_STATE_FILE=/absolute/path/to/local/story-studio-data/.story-studio/state.json

# Optional local API port. The Vite proxy uses 4192 by default.
PORT=4192
